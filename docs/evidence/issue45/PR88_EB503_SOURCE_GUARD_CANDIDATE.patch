+def _code_constant(value):
+    if isinstance(value, CodeType):
+        return _code_signature(value)
+    if type(value) is tuple:
+        return ("tuple", tuple(_code_constant(item) for item in value))
+    if type(value) is frozenset:
+        return ("frozenset", tuple(sorted((_code_constant(item) for item in value), key=repr)))
+    if type(value) is float:
+        return ("float", struct.pack(">d", value))
+    if type(value) is complex:
+        return ("complex", struct.pack(">dd", value.real, value.imag))
+    return (type(value).__name__, value)
+
+
+def _code_signature(code: CodeType):
+    return (
+        code.co_argcount, code.co_posonlyargcount, code.co_kwonlyargcount,
+        code.co_nlocals, code.co_stacksize, code.co_flags, code.co_code,
+        tuple(_code_constant(item) for item in code.co_consts), code.co_names,
+        code.co_varnames, code.co_filename, code.co_name,
+        getattr(code, "co_qualname", code.co_name), code.co_firstlineno,
+        code.co_linetable, code.co_exceptiontable, code.co_freevars,
+        code.co_cellvars,
+    )
+
+
+def _verified_wsp_pyc(path: Path, root: Path, declared: dict[str, str]) -> bool:
+    """Accept only interpreter bytecode that exactly compiles pinned source."""
+    try:
+        from .build_provenance import _file, _blob
+        source = Path(importlib.util.source_from_cache(str(path)))
+        relative = source.relative_to(root).as_posix()
+        if relative not in declared:
+            return False
+        source_raw, source_metadata = _file(source)
+        if (_blob(source_raw) != declared[relative]
+                and _blob(source_raw.replace(b"\r\n", b"\n")) != declared[relative]):
+            return False
+        raw, _ = _file(path)
+        if len(raw) < 16 or raw[:4] != importlib.util.MAGIC_NUMBER:
+            return False
+        flags = int.from_bytes(raw[4:8], "little")
+        if flags not in (0, 1, 3):
+            return False
+        if flags == 0:
+            if (int.from_bytes(raw[8:12], "little") != source_metadata[5] // 1_000_000_000
+                    or int.from_bytes(raw[12:16], "little") != source_metadata[4]):
+                return False
+        else:
+            if raw[8:16] != importlib.util.source_hash(source_raw):
+                return False
+        name = path.name
+        optimize = 1 if ".opt-1." in name else 2 if ".opt-2." in name else 0
+        expected = compile(source_raw, str(source), "exec", dont_inherit=True, optimize=optimize)
+        actual = marshal.loads(raw[16:])
+        return (type(actual) is CodeType
+                and _code_signature(actual) == _code_signature(expected))
+    except (OSError, ValueError, TypeError, ImportError, EOFError, OverflowError):
+        return False
+
+
